# =============================================================================
# AI Trading Navigator — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/trading_ai

# Redis connection string (used for caching and pub/sub)
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Exchange APIs
# -----------------------------------------------------------------------------

# Binance API credentials (https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET=your-binance-secret

# -----------------------------------------------------------------------------
# Data Sources
# -----------------------------------------------------------------------------

# Whale Alert API key for large transaction tracking (https://whale-alert.io/)
WHALE_ALERT_API_KEY=your-whale-alert-api-key

# Glassnode API key for on-chain metrics (https://glassnode.com/)
GLASSNODE_API_KEY=your-glassnode-api-key

# -----------------------------------------------------------------------------
# Social Media
# -----------------------------------------------------------------------------

# Twitter/X Bearer Token for sentiment analysis (https://developer.x.com/)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Reddit API credentials for sentiment analysis (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# -----------------------------------------------------------------------------
# AI Chat
# -----------------------------------------------------------------------------

# Anthropic API key for AI-powered chat and analysis (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------

# Telegram Bot token for sending trade signal alerts (https://core.telegram.org/bots#botfather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# -----------------------------------------------------------------------------
# Risk Settings
# -----------------------------------------------------------------------------

# Maximum portfolio drawdown percentage before kill switch activates
MAX_DRAWDOWN_PCT=10.0

# Maximum risk per single trade as a percentage of portfolio
RISK_PER_TRADE_PCT=1.5

# Minimum confidence score (0-100) required to emit a signal
MIN_SIGNAL_CONFIDENCE=50.0

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Environment: development | staging | production
ENVIRONMENT=development

# Secret key for signing tokens/sessions — MUST be changed in production
SECRET_KEY=change-me-in-production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
