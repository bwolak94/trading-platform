{
  "name": "trading-ai-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "size": "size-limit",
    "generate:types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.generated.ts"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "300 KB"
    },
    {
      "path": "dist/assets/vendor-recharts-*.js",
      "limit": "150 KB"
    },
    {
      "path": "dist/assets/vendor-lightweight-*.js",
      "limit": "150 KB"
    }
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8"
  }
}
