# docker-compose.override.yml.example
#
# Copy this file to docker-compose.override.yml for local development.
# It is listed in .gitignore so your local secrets never get committed.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#

services:
  backend:
    environment:
      # Override any env vars here for local dev without editing .env
      ENVIRONMENT: development
      # Leave the following blank to disable features during local dev
      TELEGRAM_BOT_TOKEN: ""
      ANTHROPIC_API_KEY: ""
      # Override DB/Redis to point at local Docker services
      DATABASE_URL: postgresql+asyncpg://user:pass@postgres:5432/trading_ai
      REDIS_URL: redis://redis:6379/0
      # Relax security for local dev
      SECRET_KEY: local-dev-secret-do-not-use-in-production
      ADMIN_USERNAME: admin
      ADMIN_PASSWORD: admin
    # Mount source for hot-reload
    volumes:
      - ./backend:/app

  celery-worker:
    environment:
      ENVIRONMENT: development
      DATABASE_URL: postgresql+asyncpg://user:pass@postgres:5432/trading_ai
      REDIS_URL: redis://redis:6379/0

  frontend:
    environment:
      VITE_API_TARGET: http://backend:8000
      VITE_WS_TARGET: ws://backend:8000
